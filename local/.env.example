# local 전용 값. prod와 DB·버킷·OAuth 앱·서명 키를 공유하지 않는다.
SERVICES_GATEWAY_URL=http://localhost:8080
SERVICES_AUTH_URL=http://localhost:8081
SERVICES_CONVERSATION_URL=http://localhost:8082
SERVICES_CONTENT_URL=http://localhost:8083
# GPU 작업은 워커가 가져간다(pull). local은 가짜 워커가 conversation-service의 /internal/gpu-jobs를 폴링한다.
GPU_WORKER_TOKEN=local-dev-token
# PostgreSQL (개발용). 실제 값은 .env에만 넣고 커밋하지 않는다.
# Spring 서비스는 application.yml에서 아래 이름으로 읽는다:
#   spring.datasource.url=${DB_URL}, username=${DB_USERNAME}, password=${DB_PASSWORD}
#   spring.flyway.schemas=${DB_SCHEMA}, spring.jpa.properties.hibernate.default_schema=${DB_SCHEMA}
DB_URL=jdbc:postgresql://<host>:<port>/<database>?currentSchema=<schema>
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=
# MinIO (개발용, S3 API). 실제 키는 .env에만 넣고 커밋하지 않는다.
MINIO_ENDPOINT=http://<minio-host>:<s3-api-port>   # 콘솔 주소가 아니라 S3 API 주소
MINIO_REGION=us-east-1                            # path-style 접근(forcePathStyle=true), s3v4 서명
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 버킷 하나에 접두어로 나눈다: audio-raw/, pipeline-work/, comics/, profile-images/ (docs/architecture.md 10절)
MINIO_BUCKET=4cut
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
